PORT=4173
HOST=127.0.0.1
# Padrão: Supabase, com autenticação e dados separados por conta.
STORAGE_MODE=supabase
# Configuração pública pode ser substituída no ambiente do processo:
# SUPABASE_URL=https://szvxlhubtvhazlzohpse.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Modo local exclusivo para desenvolvimento: STORAGE_MODE=json
# DATA_DIR=C:/caminho/privado/dados
# Arquivos .env são exemplos e não são carregados automaticamente.
# Acesso ao /app exige assinatura ativa na Cakto. Use false só em desenvolvimento.
# SUBSCRIPTION_REQUIRED=true
