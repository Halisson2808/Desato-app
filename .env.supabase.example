# Configuração do Supabase. A chave publishable é pública; não é senha de banco nem service_role.
SUPABASE_URL=https://szvxlhubtvhazlzohpse.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Yy-iK1WvXobH-xONsZw0IQ_1BWf7cr2
# Acesso da CLI só para o Desato (não depende do "supabase login" do computador).
# 1. Entre em supabase.com com a conta dona do projeto Desato App.
# 2. Account > Access Tokens > Generate new token (nome: desato-cli).
# 3. Copie este arquivo para .env.supabase e cole o token abaixo.
# .env.supabase é ignorado pelo Git: nunca publique o token.
SUPABASE_ACCESS_TOKEN=
